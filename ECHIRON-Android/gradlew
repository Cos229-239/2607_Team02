#!/bin/sh
APP_HOME=$(cd -P "${0%/*}" >/dev/null 2>&1 && pwd)
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Preparing the official Gradle 9.4.1 wrapper..."
  mkdir -p "$APP_HOME/gradle/wrapper"
  URL="https://raw.githubusercontent.com/gradle/gradle/v9.4.1/gradle/wrapper/gradle-wrapper.jar"
  if command -v curl >/dev/null 2>&1; then
    curl -fL "$URL" -o "$WRAPPER_JAR" || exit 1
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$WRAPPER_JAR" "$URL" || exit 1
  else
    echo "ERROR: curl or wget is required to prepare the Gradle wrapper." >&2
    exit 1
  fi
fi

if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD=java
fi

if ! command -v "$JAVACMD" >/dev/null 2>&1; then
  echo "ERROR: Java was not found. Set JAVA_HOME to JDK 17 or newer." >&2
  exit 1
fi

exec "$JAVACMD" -Dfile.encoding=UTF-8 -Xmx64m -Xms64m \
  -Dorg.gradle.appname=gradlew \
  -jar "$WRAPPER_JAR" "$@"
